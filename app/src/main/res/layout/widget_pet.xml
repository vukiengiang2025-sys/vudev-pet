<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_face"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_pet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/widget_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#16233F"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/widget_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#5B6B8C"
                android:textSize="13sp"
                android:text="@string/mood_calm" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_needs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textColor="#5B6B8C"
        android:textSize="12sp"
        android:text="@string/needs_title" />
</LinearLayout>
